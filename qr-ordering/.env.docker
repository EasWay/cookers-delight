APP_NAME="Cookers Delight QR"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://qr.cookersdelight.com

# ── Paystack ───────────────────────────────────────────────────────────────────
# CRITICAL: Register the webhook in your Paystack dashboard BEFORE go-live:
#   {APP_URL}/PayStack/webhook
# e.g. https://qr.cookersdelight.com/PayStack/webhook
#
# Using ngrok or a tunnel URL will cause silent payment failures.
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
