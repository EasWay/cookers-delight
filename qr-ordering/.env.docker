# ─────────────────────────────────────────────────────────────────────────────
# QR Ordering (kawax) — Docker Environment Template
# Copy to qr-ordering/.env: cp qr-ordering/.env.docker qr-ordering/.env
# Then run: make key-qr
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Cookers Delight — Table Ordering"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# TastyIgniter backend URL + API token (use Docker service name 'backend' internally)
# The QR app talks to TastyIgniter via the internal Docker network
TASTYIGNITER_API_URL=http://nginx/api
TASTYIGNITER_API_TOKEN=your_tastyigniter_api_token_here

# App-level backend URL (for table-session lookups, without /api suffix)
BACKEND_URL=http://nginx

KITCHEN_PIN=1234

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cookers_delight_qr
DB_USERNAME=cookers
DB_PASSWORD=secret_change_me

# ── Cache / Queue / Session ───────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=orders@cookersdelight.com
MAIL_FROM_NAME="Cookers Delight"
MAIL_ADMIN_ADDRESS=admin@cookersdelight.com

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
