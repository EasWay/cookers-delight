APP_NAME="Cookers Delight"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cookersdelight.com

# ── Paystack ───────────────────────────────────────────────────────────────────
# Keys are also configurable via Settings → Payments in the admin UI.
# The webhook for DINE-IN QR orders is handled by the qr-ordering app, not here.
# Webhook path: {qr-ordering APP_URL}/PayStack/webhook
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# ── Direct checkout (Phase 2a) — pre-arrival / collection orders ──────────────
APP_FRONTEND_URL=http://localhost:5173
TASTYIGNITER_API_URL=http://localhost:8000/api
TASTYIGNITER_API_TOKEN=your_ti_token_here
TASTYIGNITER_DEFAULT_LOCATION_ID=1

# ── QR dine-in checkout (Phase 2b) — base URL of the apps/qr Vite app ────────
QR_APP_URL=http://localhost:5174

# ── Kitchen display PIN ────────────────────────────────────────────────────────
KITCHEN_PIN=1234
