# ─────────────────────────────────────────────────────────────────────────────
# Backend (TastyIgniter) — Docker Environment Template
# Copy to backend/.env: cp backend/.env.docker backend/.env
# Then run: make key-backend
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Cookers Delight"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Allowed CORS origins for the admin SPA
APP_CORS_ORIGINS=http://localhost

# QR ordering URL (for QR code generation)
QR_ORDERING_URL=http://localhost
QR_ORDER_URL=http://localhost

IGNITER_LOCATION_MODE=multiple
IGNITER_CARTE_KEY=

# ── Database (uses Docker service name 'mysql') ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cookers_delight
DB_USERNAME=cookers
DB_PASSWORD=secret_change_me
DB_PREFIX=ti_

# ── Cache / Queue / Session (Redis) ──────────────────────────────────────────
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Redis (uses Docker service name 'redis') ──────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Laravel Reverb ────────────────────────────────────────────────────────────
REVERB_APP_ID=cookers-delight
REVERB_APP_KEY=cookers-delight-key
REVERB_APP_SECRET=cookers-delight-secret-change-in-prod
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Mail (Mailpit in dev, real SMTP in prod) ──────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@cookersdelight.com
MAIL_FROM_NAME="Cookers Delight"
MAIL_ADMIN_ADDRESS=admin@cookersdelight.com

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_FLAG_EXTENDED_SESSION_RESPONSE=false
