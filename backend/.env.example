# APP CONFIG (DO NOT REMOVE!)
APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=multiple

# Origins allowed by the API's CORS layer (comma-separated). Falls back to
# APP_URL if unset. Set to your Vite dev URL locally, your prod domain in prod.
APP_CORS_ORIGINS=http://localhost:5173

# Base URL the table-QR codes point at. Defaults to http://localhost:5173.
# Localhost is auto-rewritten to the dev machine's LAN IP at QR generation
# time so phones on the same Wi-Fi can reach it. Override with an ngrok URL
# or your prod domain when deploying:
#   QR_ORDERING_URL=https://orders.cookersdelight.com
QR_ORDERING_URL=

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tastyigniter.tld
MAIL_FROM_NAME="${APP_NAME}"
