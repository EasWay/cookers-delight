{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "nodemon server/index.js",
    "client": "vite",
    "seed": "node server/seed.js",
    "studio": "cd server && npx prisma studio",
    "db:push": "cd server && npx prisma db push",
    "db:generate": "cd server && npx prisma generate",
    "build": "vite build",
    "generate-icons": "node scripts/generate-icons.js",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/__tests__/smoke.test.ts",
    "test:functional": "vitest run src/__tests__/functional.test.ts",
    "test:integration": "vitest run src/__tests__/integration.test.ts",
    "test:regression": "vitest run src/__tests__/regression.test.ts",
    "test:security": "vitest run src/__tests__/security.test.ts",
    "test:fuzz": "vitest run src/__tests__/fuzz.test.ts",
    "test:ui": "vitest run src/__tests__/ui.test.tsx",
    "dev:qr":   "cd apps/qr && pnpm install --frozen-lockfile && pnpm dev",
    "build:qr": "cd apps/qr && pnpm install --frozen-lockfile && pnpm build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@react-google-maps/api": "^2.20.8",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "nodemon": "^3.1.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.1"
  }
}
