# ═════════════════════════════════════════════════════════════════════════════
# Cookers Delight — Root Environment Template
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# This file drives:
#   - docker-compose.yml (DB_PASSWORD, REDIS_PASSWORD, ports)
#   - Vite frontend (VITE_*)
#
# Each PHP app (backend/, qr-ordering/) has its OWN .env file.
# Bootstrap them with:
#   cp backend/.env.docker    backend/.env
#   cp qr-ordering/.env.docker qr-ordering/.env
# ═════════════════════════════════════════════════════════════════════════════

# ── Docker Compose ────────────────────────────────────────────────────────────
NGINX_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=root_secret_change_me
DB_PASSWORD=secret_change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Vite Frontend ─────────────────────────────────────────────────────────────
VITE_TI_API_URL=
VITE_TI_API_TOKEN=
VITE_DEV_PROXY_TARGET=http://nginx:80
VITE_QR_ORDER_URL=http://localhost/
GEMINI_API_KEY=
