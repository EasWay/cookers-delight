# ─── TastyIgniter REST API ──────────────────────────────────────────────────
# In production, set these to your live TastyIgniter base URL + API token.
# In dev, leave VITE_TI_API_URL unset so calls go through the Vite proxy
# (vite.config.ts → server.proxy) and avoid CORS issues.
VITE_TI_API_URL=
VITE_TI_API_TOKEN=your_tastyigniter_api_token_here

# Override the TastyIgniter URL the Vite dev proxy points at.
# Defaults to http://127.0.0.1:8000 (matches `php artisan serve --port=8000`).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# ─── QR Ordering base URL (kawax/self-ordering) ─────────────────────────────
VITE_QR_ORDER_URL=http://localhost:8001
