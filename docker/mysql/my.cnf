[mysqld]
# ─── Cookers Delight MySQL Config ───────────────────────────────────────────
# Applied to both dev and production containers.

# Character set
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# Generous limits for TastyIgniter's wide tables
innodb_buffer_pool_size   = 256M
innodb_log_file_size      = 64M
innodb_flush_log_at_trx_commit = 2  # slight perf gain (safe for this use case)

# Allow large JSON + long VARCHAR in TI's menu_options columns
max_allowed_packet = 64M
group_concat_max_len = 65536

# Slower-query logging (helps identify N+1 issues)
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

# Disable strict mode to match TastyIgniter's expectations
sql_mode = "NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
