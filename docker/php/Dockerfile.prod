# ─────────────────────────────────────────────────────────────────────────────
# Production PHP Image — Multi-Stage
# Stage 1 (builder): install Composer deps
# Stage 2 (runtime): lean PHP-FPM image, OPcache ON
# ─────────────────────────────────────────────────────────────────────────────

ARG APP_DIR=backend

# ──────────────────────────────────────────────────────────────────────────────
# STAGE 1 — Composer dependency install
# ──────────────────────────────────────────────────────────────────────────────
FROM composer:2 AS builder

ARG APP_DIR

WORKDIR /app

# Copy only composer files first (layer cache: re-run install only when these change)
COPY ${APP_DIR}/composer.json ${APP_DIR}/composer.lock ./

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --optimize-autoloader \
        --no-scripts

# Now copy full source and run post-install scripts
COPY ${APP_DIR}/ .

RUN composer run-script post-autoload-dump 2>/dev/null || true

# ──────────────────────────────────────────────────────────────────────────────
# STAGE 2 — Runtime image
# ──────────────────────────────────────────────────────────────────────────────
FROM php:8.3-fpm-alpine AS runtime

ARG APP_DIR

# System deps
RUN apk add --no-cache \
    bash \
    curl \
    zip \
    unzip \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    libzip-dev \
    icu-dev \
    mysql-client

# PHP extensions
RUN docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        mbstring \
        zip \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        opcache

RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

# Copy application from builder (includes vendor/)
WORKDIR /var/www/${APP_DIR}
COPY --from=builder /app .

# Correct permissions
RUN chown -R www-data:www-data /var/www/${APP_DIR}/storage \
    && chown -R www-data:www-data /var/www/${APP_DIR}/bootstrap/cache \
    && chmod -R 775 /var/www/${APP_DIR}/storage \
    && chmod -R 775 /var/www/${APP_DIR}/bootstrap/cache

# Prod entrypoint
COPY entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
