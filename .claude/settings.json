{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "n8n-mcp": {
      "command": "node",
      "args": [
        "/home/user/cookers-delight/ai-frameworks/n8n-mcp/dist/index.js"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "N8N_ENFORCE_SETTINGS_SCHEMA": "false"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[cookers-delight] Pre-bash check running'",
            "description": "Project-level pre-bash guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)"
    ]
  }
}
