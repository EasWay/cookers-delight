# ── Stage 1: Build public site (src/) ────────────────────────────────────────
FROM node:20-alpine AS web-builder
WORKDIR /app
RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY src/        ./src/
COPY public/     ./public/
COPY index.html  vite.config.ts tsconfig.json tsconfig.app.json ./

ARG VITE_TI_API_URL
ARG VITE_TI_API_TOKEN
ARG VITE_TI_BASE_URL

RUN pnpm run build

# ── Stage 2: Build QR app (apps/qr/) ─────────────────────────────────────────
FROM node:20-alpine AS qr-builder
WORKDIR /app
RUN npm install -g pnpm

COPY apps/qr/package.json apps/qr/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/qr/ .

ARG VITE_API_TARGET=http://backend:9000

RUN pnpm run build

# ── Stage 3: Nginx runtime ────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY --from=web-builder /app/dist /usr/share/nginx/web
COPY --from=qr-builder  /app/dist /usr/share/nginx/qr

EXPOSE 80 443
